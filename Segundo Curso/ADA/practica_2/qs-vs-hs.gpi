#24503990C Eric Batalla Ortúzar

# Configuraciónde las gráficas
set terminal pngcairo size 800,600 enhanced font 'Arial,11'
set grid
set key top left box
set xlabel "Tamaño del vector (N)"
set ylabel "Millones de pasos de programa (Msteps)"

#QuickSort en los 3 casos
set output "quickSort.png"
set title "Análisis de QuickSort"
plot "qs-vs-hs.Msteps" using 1:2 with lines lw 2 title "Vectores Aleatorios", \
     "qs-vs-hs.Msteps" using 1:4 with lines lw 2 title "Vectores Ordenados", \
     "qs-vs-hs.Msteps" using 1:6 with lines lw 2 title "Vectores Reversos"

#HeapSort en los 3 casos
set output "heapSort.png"
set title "Análisis del Algoritmo HeapSort"
plot "qs-vs-hs.Msteps" using 1:3 with lines lw 2 title "Vectores Aleatorios", \
     "qs-vs-hs.Msteps" using 1:5 with lines lw 2 title "Vectores Ordenados", \
     "qs-vs-hs.Msteps" using 1:7 with lines lw 2 title "Vectores Reversos"

#Funciones O(N log N), una para cada algoritmo, se miden independientemente
f(x) = a*x*log(x) + b*x + c
g(x) = d*x*log(x) + e*x + f

#QuickSort vs HeapSort con vectores aleatorios
set output "qs-vs-hs-RA.png"
set title "QuickSort vs HeapSort (Vectores Aleatorios)"

# Ajuste de datos de la columna 2 (QS) y 3 (HS)
fit f(x) "qs-vs-hs.Msteps" using 1:2 via a, b, c
fit g(x) "qs-vs-hs.Msteps" using 1:3 via d, e, f

plot "qs-vs-hs.Msteps" using 1:2 with lines lw 2 title "QuickSort (Datos Reales)", \
     f(x) with lines lw 2 title "QuickSort (Ajuste O(N log N))", \
     "qs-vs-hs.Msteps" using 1:3 with lines lw 2 title "HeapSort (Datos Reales)", \
     g(x) with lines lw 2 title "HeapSort (Ajuste O(N log N))"

#QuickSort vs HeapSort con vectores ordenados
set output "qs-vs-hs-SA.png"
set title "QuickSort vs HeapSort (Vectores Ordenados)"

# Ajuste de datos de la columna 4 (QS) y 5 (HS)
fit f(x) "qs-vs-hs.Msteps" using 1:4 via a, b, c
fit g(x) "qs-vs-hs.Msteps" using 1:5 via d, e, f

plot "qs-vs-hs.Msteps" using 1:4 with lines lw 2 title "QuickSort (Datos Reales)", \
     f(x) with lines lw 2 title "QuickSort (Ajuste O(N log N))", \
     "qs-vs-hs.Msteps" using 1:5 with lines lw 2 title "HeapSort (Datos Reales)", \
     g(x) with lines lw 2 title "HeapSort (Ajuste O(N log N))"

#QuickSort vs HeapSort con vectores reversos
set output "qs-vs-hs-RSA.png"
set title "QuickSort vs HeapSort (Vectores en Orden Inverso)"

# Ajuste de datos de la columna 6 (QS) y 7 (HS)
fit f(x) "qs-vs-hs.Msteps" using 1:6 via a, b, c
fit g(x) "qs-vs-hs.Msteps" using 1:7 via d, e, f

plot "qs-vs-hs.Msteps" using 1:6 with lines lw 2 title "QuickSort (Datos Reales)", \
     f(x) with lines lw 2 title "QuickSort (Ajuste O(N log N))", \
     "qs-vs-hs.Msteps" using 1:7 with lines lw 2 title "HeapSort (Datos Reales)", \
     g(x) with lines lw 2 title "HeapSort (Ajuste O(N log N))"